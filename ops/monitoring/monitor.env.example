# Installed as /etc/simes/monitor.env (root:root, mode 0600).
SIMES_BACKUP_STATUS_FILE=/var/lib/simes-ops/backup-last-success
SIMES_BACKUP_MAX_AGE_HOURS=36
SIMES_OPS_STATUS_DIR=/var/lib/simes-ops

# Keep false while gateways are intentionally powered off.
# Change to true, then run `systemctl start simes-ops-monitor.service`,
# when normal telemetry transmission resumes.
SIMES_FRESHNESS_ENABLED=false
SIMES_FRESHNESS_WARN_MINUTES=30
SIMES_FRESHNESS_CRITICAL_MINUTES=60
