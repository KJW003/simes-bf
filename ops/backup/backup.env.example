# Installed as /etc/simes/backup.env (root:root, mode 0600).
SIMES_REPO_DIR=/home/simes/simes-bf
SIMES_BACKUP_ROOT=/var/backups/simes/daily
SIMES_LOCAL_RETENTION_DAYS=14
SIMES_OFFSITE_EXPORT_DIR=/srv/simes-backup-export/archives
SIMES_OFFSITE_RETENTION_DAYS=30
SIMES_BACKUP_RECIPIENT_CERT=/etc/simes/backup-recipient.crt
SIMES_PG_DIRTYREAD_SNAPSHOT=/var/backups/simes/pre-remediation-20260729T142520Z/dependencies/pg_dirtyread-pg16
SIMES_OPS_STATUS_DIR=/var/lib/simes-ops
SIMES_BACKUP_HELPER_IMAGE=redis:7-alpine
SIMES_BACKUP_KEEP_DIRECTORY=false
